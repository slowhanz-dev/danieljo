<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BUNNAR · 업무 현황판</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Pretendard:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#f7f6f3;
  --surface:#ffffff;
  --surface2:#f0efe9;
  --border:#e2e0d8;
  --border2:#ccc9bc;
  --text:#1a1a18;
  --text2:#6b6960;
  --text3:#a09d92;
  --green:#1D9E75;
  --blue:#185FA5;
  --amber:#854F0B;
  --red:#993556;
  --radius:12px;
  --radius-sm:8px;
}
@media(prefers-color-scheme:dark){
  :root{
    --bg:#0f0f0d;
    --surface:#1a1a17;
    --surface2:#232320;
    --border:#2a2a26;
    --border2:#3a3a34;
    --text:#f0ede6;
    --text2:#9a9790;
    --text3:#5a5952;
    --green:#4ADE80;
    --blue:#60A5FA;
    --amber:#FCD34D;
    --red:#F87171;
  }
}
body{
  font-family:'Pretendard',system-ui,sans-serif;
  background:var(--bg);
  color:var(--text);
  min-height:100vh;
  font-size:14px;
  line-height:1.5;
}

/* ─── Layout ─── */
.header{
  background:var(--surface);
  border-bottom:1px solid var(--border);
  padding:20px 32px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  position:sticky;
  top:0;
  z-index:100;
}
.logo{font-size:18px;font-weight:600;letter-spacing:.04em}
.logo span{font-weight:300;opacity:.5;margin-left:6px;font-size:13px}
.header-actions{display:flex;gap:8px;align-items:center}
.main{max-width:1200px;margin:0 auto;padding:28px 24px 60px}

/* ─── Stats ─── */
.stats-row{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-bottom:24px}
.stat{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-sm);padding:14px 16px;text-align:center}
.stat-num{font-size:26px;font-weight:500}
.stat-label{font-size:11px;color:var(--text2);margin-top:2px;letter-spacing:.04em}

/* ─── Filter ─── */
.filter-row{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px}
.fbtn{
  background:transparent;
  border:1px solid var(--border2);
  border-radius:20px;
  padding:5px 14px;
  font-size:12px;
  color:var(--text2);
  cursor:pointer;
  font-family:inherit;
  transition:all .15s;
}
.fbtn:hover,.fbtn.on{
  background:var(--text);
  border-color:var(--text);
  color:var(--bg);
}
.hint{font-size:11px;color:var(--text3);margin-bottom:20px}

/* ─── Grid ─── */
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:14px}

/* ─── Card ─── */
.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;display:flex;flex-direction:column}
.card-head{
  display:flex;align-items:center;gap:10px;
  padding:14px 16px 12px;
  border-bottom:1px solid var(--border);
}
.card-icon{font-size:16px;flex-shrink:0}
.card-label{font-size:13px;font-weight:600;flex:1}
.card-meta{font-size:11px;color:var(--text3)}
.pbar{height:2px;background:var(--border)}
.pfill{height:100%;transition:width .4s ease}
.items{padding:4px 0;flex:1}

/* ─── Item row ─── */
.irow{
  display:flex;align-items:flex-start;gap:8px;
  padding:8px 16px;
  cursor:pointer;
  transition:background .12s;
  position:relative;
}
.irow:hover{background:var(--surface2)}
.irow.editing{background:var(--surface2)}
.iname{
  flex:1;font-size:12px;
  color:var(--text);
  line-height:1.45;
  word-break:keep-all;
}
.itag{
  font-size:10px;
  background:#fef3c7;
  color:#92400e;
  padding:1px 6px;border-radius:8px;
  margin-left:4px;
  display:inline-block;
}
.badge{
  font-size:10px;font-weight:500;
  padding:2px 9px;border-radius:10px;
  white-space:nowrap;cursor:pointer;
  flex-shrink:0;margin-top:1px;
  border:none;font-family:inherit;
  transition:opacity .12s;
}
.badge:hover{opacity:.75}
.del-btn{
  background:none;border:none;cursor:pointer;
  color:var(--text3);font-size:14px;
  padding:0 0 0 4px;opacity:0;
  transition:opacity .12s;
  line-height:1;
}
.irow:hover .del-btn{opacity:1}
.del-btn:hover{color:var(--red)}

/* ─── Add item ─── */
.add-row{padding:6px 16px 10px}
.add-input{
  width:100%;
  background:transparent;
  border:1px solid var(--border2);
  border-radius:6px;
  padding:7px 10px;
  font-size:12px;
  color:var(--text);
  font-family:inherit;
  outline:none;
}
.add-input:focus{border-color:var(--blue);background:var(--surface2)}
.add-input::placeholder{color:var(--text3)}

/* ─── Category add ─── */
.add-cat-btn{
  display:flex;align-items:center;justify-content:center;gap:8px;
  background:var(--surface);
  border:1px dashed var(--border2);
  border-radius:var(--radius);
  padding:24px;
  cursor:pointer;
  color:var(--text2);
  font-size:13px;
  font-family:inherit;
  width:100%;
  transition:all .15s;
}
.add-cat-btn:hover{background:var(--surface2);border-color:var(--text2);color:var(--text)}

/* ─── Buttons ─── */
.btn{
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:var(--radius-sm);
  padding:7px 14px;
  font-size:12px;
  font-family:inherit;
  cursor:pointer;
  color:var(--text);
  transition:all .15s;
}
.btn:hover{background:var(--surface2)}
.btn-primary{
  background:var(--text);color:var(--bg);border-color:var(--text);
}
.btn-primary:hover{opacity:.85}

/* ─── Modal ─── */
.modal-overlay{
  position:fixed;inset:0;
  background:rgba(0,0,0,.45);
  display:flex;align-items:center;justify-content:center;
  z-index:200;
  padding:20px;
}
.modal{
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:var(--radius);
  padding:24px;
  width:100%;max-width:400px;
}
.modal h3{font-size:15px;font-weight:600;margin-bottom:16px}
.modal label{font-size:12px;color:var(--text2);display:block;margin-bottom:4px}
.modal input,.modal select{
  width:100%;
  background:var(--surface2);
  border:1px solid var(--border2);
  border-radius:6px;
  padding:8px 10px;
  font-size:13px;
  color:var(--text);
  font-family:inherit;
  outline:none;
  margin-bottom:14px;
}
.modal-actions{display:flex;gap:8px;justify-content:flex-end;margin-top:4px}

/* ─── Save notice ─── */
.save-toast{
  position:fixed;bottom:24px;right:24px;
  background:var(--text);color:var(--bg);
  border-radius:var(--radius-sm);
  padding:8px 16px;font-size:12px;
  opacity:0;pointer-events:none;
  transition:opacity .25s;
  z-index:300;
}
.save-toast.show{opacity:1}

/* ─── Responsive ─── */
@media(max-width:600px){
  .header{padding:14px 16px}
  .main{padding:16px 12px 60px}
  .stats-row{grid-template-columns:repeat(3,1fr)}
  .stats-row .stat:nth-child(4),.stats-row .stat:nth-child(5){display:none}
}
</style>
</head>
<body>

<div class="header">
  <div>
    <span class="logo">BUNNAR <span>· 업무 현황판</span></span>
  </div>
  <div class="header-actions">
    <button class="btn" onclick="exportData()">📤 내보내기</button>
    <button class="btn" onclick="triggerImport()">📥 가져오기</button>
    <input type="file" id="importFile" accept=".json" style="display:none" onchange="importData(event)">
    <button class="btn btn-primary" onclick="showAddCat()">+ 카테고리 추가</button>
  </div>
</div>

<div class="main">
  <div class="stats-row" id="sg"></div>

  <div class="filter-row" id="fr">
    <button class="fbtn on" data-f="all">전체</button>
    <button class="fbtn" data-f="완료">완료</button>
    <button class="fbtn" data-f="진행중">진행중</button>
    <button class="fbtn" data-f="심사중">심사중</button>
    <button class="fbtn" data-f="신청완료">신청완료</button>
    <button class="fbtn" data-f="예정">예정</button>
    <button class="fbtn" data-f="탈락">탈락</button>
  </div>
  <p class="hint">상태 배지 클릭 → 순환 변경 &nbsp;·&nbsp; 항목 우측 × → 삭제 &nbsp;·&nbsp; 카드 하단 입력 → 새 항목 추가 &nbsp;·&nbsp; 모든 변경사항 자동 저장</p>

  <div class="grid" id="mg"></div>
</div>

<!-- Add category modal -->
<div class="modal-overlay" id="catModal" style="display:none" onclick="closeCatModal(event)">
  <div class="modal" onclick="event.stopPropagation()">
    <h3>새 카테고리 추가</h3>
    <label>카테고리 이름</label>
    <input type="text" id="catName" placeholder="예: 재무 관리" />
    <label>아이콘 (이모지 또는 텍스트)</label>
    <input type="text" id="catIcon" placeholder="예: 💰" />
    <label>포인트 컬러</label>
    <input type="color" id="catColor" value="#378ADD" style="height:40px;cursor:pointer" />
    <div class="modal-actions">
      <button class="btn" onclick="closeCatModalDirect()">취소</button>
      <button class="btn btn-primary" onclick="addCategory()">추가</button>
    </div>
  </div>
</div>

<!-- Save toast -->
<div class="save-toast" id="toast">✓ 저장됨</div>

<script>
// ── Constants ──────────────────────────────
const KEY = 'bunnar_dashboard_v1';
const STATUSES = ['완료','진행중','심사중','신청완료','예정','탈락'];
const BADGE_STYLE = {
  '완료':   'background:#9FE1CB;color:#085041',
  '진행중': 'background:#B5D4F4;color:#0C447C',
  '심사중': 'background:#FAC775;color:#633806',
  '신청완료':'background:#AFA9EC;color:#3C3489',
  '예정':   'background:#D3D1C7;color:#444441',
  '탈락':   'background:#F09595;color:#791F1F',
};

// ── Default data ───────────────────────────
const DEFAULT = [
  {id:'grants',label:'지원사업',icon:'🏛️',color:'#378ADD',items:[
    {n:'판판대로 TOPS 온라인 브랜드 육성사업',s:'탈락'},
    {n:'판판대로 SNS마케팅 지원사업',s:'심사중'},
    {n:'판판대로 상품개선 지원사업',s:'심사중'},
    {n:'화성e샵 복지몰 입점 지원',s:'심사중'},
    {n:'판판셀러 통합관리시스템',s:'신청완료'},
    {n:'소공인 자생력강화사업',s:'진행중',tag:'⚡ 마감 D-3'},
    {n:'소공인 스마트제조 지원사업',s:'진행중'},
    {n:'경기도 제품디자인개발 지원사업',s:'신청완료'},
  ]},
  {id:'web',label:'웹사이트 개발',icon:'🌐',color:'#1D9E75',items:[
    {n:'bunnar.kr 모바일 UX 개선',s:'진행중'},
    {n:'블로그 아카이브 재설계',s:'진행중'},
    {n:'브랜드 카피라이팅',s:'진행중'},
    {n:'드로어 메뉴 CSS 작업',s:'완료'},
    {n:'Pretendard 폰트 적용',s:'완료'},
    {n:'danieljo.com 기본 구축',s:'완료'},
    {n:'JSON 프로젝트 데이터 시스템',s:'완료'},
    {n:'Google Sheets → projects.json 연동',s:'예정'},
    {n:'이미지 비율 제한 제거',s:'예정'},
    {n:'Cloudinary 이미지 호스팅',s:'예정'},
  ]},
  {id:'sns',label:'SNS / 마케팅',icon:'📡',color:'#BA7517',items:[
    {n:'핀터레스트 계정 운영',s:'예정'},
    {n:'링크드인 계정 운영',s:'예정'},
    {n:'광고 소재 다듬기',s:'진행중'},
    {n:'마케팅 자동화 세팅',s:'예정'},
  ]},
  {id:'overseas',label:'해외 B2B / 홍보',icon:'✈️',color:'#3B6D11',items:[
    {n:'BLÆK Coffee (함부르크) 샘플+결제',s:'완료'},
    {n:'네덜란드 바이어 관계 관리',s:'진행중'},
    {n:'호주 바이어 관계 관리',s:'진행중'},
    {n:'일본 바이어 관계 관리',s:'진행중'},
    {n:'독일 바이어 관계 관리',s:'진행중'},
    {n:'해외 Shopify 스토어 운영',s:'진행중'},
  ]},
  {id:'prod',label:'생산 / ODM',icon:'🏭',color:'#7F77DD',items:[
    {n:'GBH 6,000유닛 ODM 계약',s:'완료'},
    {n:'신창세라믹 제조계약 체결',s:'완료'},
    {n:'공장등록 (화성시청)',s:'완료'},
    {n:'직접생산 체계 검토',s:'진행중'},
    {n:'소형 전기가마 도입 검토',s:'예정'},
  ]},
  {id:'brand',label:'브랜드 전략',icon:'✦',color:'#D85A30',items:[
    {n:'제품명 다듬기',s:'진행중'},
    {n:'10피스 테이블웨어 시스템 개발',s:'진행중'},
    {n:'패키징 디자인 지원사업 신청',s:'신청완료'},
    {n:'럭셔리 브랜드 라이센싱 전략',s:'예정'},
    {n:'Arita (일본) 연계 기획',s:'예정'},
  ]},
];

// ── State ──────────────────────────────────
let DATA = loadData();
let activeFilter = 'all';

function loadData() {
  try {
    const saved = localStorage.getItem(KEY);
    return saved ? JSON.parse(saved) : JSON.parse(JSON.stringify(DEFAULT));
  } catch(e) {
    return JSON.parse(JSON.stringify(DEFAULT));
  }
}

function save() {
  try {
    localStorage.setItem(KEY, JSON.stringify(DATA));
    showToast();
  } catch(e) {}
}

function showToast() {
  const t = document.getElementById('toast');
  t.classList.add('show');
  clearTimeout(window._toastT);
  window._toastT = setTimeout(() => t.classList.remove('show'), 1500);
}

// ── Stats ──────────────────────────────────
function calcStats() {
  const all = DATA.flatMap(c => c.items);
  const done = all.filter(i => i.s === '완료').length;
  return {
    total: all.length,
    done,
    active: all.filter(i => ['진행중','심사중','신청완료'].includes(i.s)).length,
    plan: all.filter(i => i.s === '예정').length,
    fail: all.filter(i => i.s === '탈락').length,
    pct: all.length ? Math.round(done / all.length * 100) : 0,
  };
}

// ── Cycle status ───────────────────────────
function cycleStatus(catId, itemIdx) {
  const cat = DATA.find(c => c.id === catId);
  if (!cat) return;
  const item = cat.items[itemIdx];
  if (!item) return;
  item.s = STATUSES[(STATUSES.indexOf(item.s) + 1) % STATUSES.length];
  save();
  render();
}

// ── Delete item ────────────────────────────
function deleteItem(catId, itemIdx) {
  const cat = DATA.find(c => c.id === catId);
  if (!cat) return;
  cat.items.splice(itemIdx, 1);
  save();
  render();
}

// ── Delete category ────────────────────────
function deleteCat(catId) {
  if (!confirm('이 카테고리를 삭제할까요?')) return;
  DATA = DATA.filter(c => c.id !== catId);
  save();
  render();
}

// ── Add item on Enter ──────────────────────
function addItemKey(e, catId) {
  if (e.key !== 'Enter') return;
  const input = e.target;
  const text = input.value.trim();
  if (!text) return;
  const cat = DATA.find(c => c.id === catId);
  if (!cat) return;
  cat.items.push({ n: text, s: '예정' });
  input.value = '';
  save();
  render();
  // Re-focus the input after render
  setTimeout(() => {
    const inp = document.getElementById('inp_' + catId);
    if (inp) inp.focus();
  }, 50);
}

// ── Add category ───────────────────────────
function showAddCat() {
  document.getElementById('catModal').style.display = 'flex';
  document.getElementById('catName').focus();
}
function closeCatModal(e) {
  if (e.target === document.getElementById('catModal')) closeCatModalDirect();
}
function closeCatModalDirect() {
  document.getElementById('catModal').style.display = 'none';
  document.getElementById('catName').value = '';
  document.getElementById('catIcon').value = '';
}
function addCategory() {
  const name = document.getElementById('catName').value.trim();
  if (!name) { alert('이름을 입력하세요'); return; }
  const icon = document.getElementById('catIcon').value.trim() || '📌';
  const color = document.getElementById('catColor').value;
  const id = 'cat_' + Date.now();
  DATA.push({ id, label: name, icon, color, items: [] });
  save();
  render();
  closeCatModalDirect();
}

// ── Export / Import ────────────────────────
function exportData() {
  const blob = new Blob([JSON.stringify(DATA, null, 2)], { type: 'application/json' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'bunnar-dashboard-' + new Date().toISOString().slice(0,10) + '.json';
  a.click();
}
function triggerImport() {
  document.getElementById('importFile').click();
}
function importData(e) {
  const file = e.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = function(ev) {
    try {
      const parsed = JSON.parse(ev.target.result);
      if (!Array.isArray(parsed)) throw new Error();
      DATA = parsed;
      save();
      render();
      alert('가져오기 완료!');
    } catch(err) {
      alert('올바른 JSON 파일이 아닙니다.');
    }
  };
  reader.readAsText(file);
  e.target.value = '';
}

// ── Render ─────────────────────────────────
function render() {
  const s = calcStats();

  // Stats
  document.getElementById('sg').innerHTML = `
    <div class="stat"><div class="stat-num">${s.total}</div><div class="stat-label">전체</div></div>
    <div class="stat"><div class="stat-num" style="color:var(--green)">${s.done}</div><div class="stat-label">완료</div></div>
    <div class="stat"><div class="stat-num" style="color:var(--blue)">${s.active}</div><div class="stat-label">진행중</div></div>
    <div class="stat"><div class="stat-num" style="color:var(--text2)">${s.plan}</div><div class="stat-label">예정</div></div>
    <div class="stat"><div class="stat-num" style="color:${s.pct >= 50 ? 'var(--green)' : 'var(--red)'}">${s.pct}%</div><div class="stat-label">완료율</div></div>
  `;

  // Cards
  const grid = document.getElementById('mg');
  grid.innerHTML = '';

  DATA.forEach(cat => {
    const done = cat.items.filter(i => i.s === '완료').length;
    const pct = cat.items.length ? Math.round(done / cat.items.length * 100) : 0;
    const vis = activeFilter === 'all' ? cat.items : cat.items.filter(i => i.s === activeFilter);

    const card = document.createElement('div');
    card.className = 'card';

    // Header
    card.innerHTML = `
      <div class="card-head">
        <span class="card-icon">${cat.icon}</span>
        <span class="card-label">${cat.label}</span>
        <span class="card-meta">${done}/${cat.items.length} &nbsp; ${pct}%</span>
        <button onclick="deleteCat('${cat.id}')" style="background:none;border:none;cursor:pointer;color:var(--text3);font-size:16px;padding:0 0 0 8px;line-height:1" title="카테고리 삭제">×</button>
      </div>
      <div class="pbar"><div class="pfill" style="width:${pct}%;background:${cat.color}"></div></div>
    `;

    // Items
    const itemsDiv = document.createElement('div');
    itemsDiv.className = 'items';

    vis.forEach(item => {
      const realIdx = cat.items.indexOf(item);
      const row = document.createElement('div');
      row.className = 'irow';
      row.innerHTML = `
        <span class="iname">${item.n}${item.tag ? `<span class="itag">${item.tag}</span>` : ''}</span>
        <button class="badge" style="${BADGE_STYLE[item.s]}" onclick="event.stopPropagation();cycleStatus('${cat.id}',${realIdx})" title="클릭하여 상태 변경">${item.s}</button>
        <button class="del-btn" onclick="event.stopPropagation();deleteItem('${cat.id}',${realIdx})" title="삭제">×</button>
      `;
      itemsDiv.appendChild(row);
    });

    card.appendChild(itemsDiv);

    // Add input
    const addRow = document.createElement('div');
    addRow.className = 'add-row';
    addRow.innerHTML = `<input class="add-input" id="inp_${cat.id}" placeholder="+ 새 항목 추가 후 Enter" onkeydown="addItemKey(event,'${cat.id}')">`;
    card.appendChild(addRow);

    grid.appendChild(card);
  });

  // Add category button
  const addBtn = document.createElement('button');
  addBtn.className = 'add-cat-btn';
  addBtn.innerHTML = '＋ 새 카테고리 추가';
  addBtn.onclick = showAddCat;
  grid.appendChild(addBtn);
}

// ── Filter ─────────────────────────────────
document.getElementById('fr').addEventListener('click', e => {
  const b = e.target.closest('[data-f]');
  if (!b) return;
  document.querySelectorAll('.fbtn').forEach(x => x.classList.remove('on'));
  b.classList.add('on');
  activeFilter = b.dataset.f;
  render();
});

// ── Init ────────────────────────────────────
render();
</script>
</body>
</html>
